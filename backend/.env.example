# Example environment variables for the LifeLoop backend
# Copy this file to `.env` and fill in your real values. Do NOT commit your real .env!

# ──────────────
# Server
# ──────────────
PORT=5000
NODE_ENV=development

# ──────────────
# Database
# ──────────────
MONGO_URI=mongodb://127.0.0.1:27017/lifeloop

# ──────────────
# Authentication (JWT)
# ──────────────
JWT_SECRET=your_super_secret_key_min_32_chars
JWT_EXPIRES_IN=1d

# ──────────────
# M1 Waste Classifier — the project's own model, served from ml/serve/app.py
#   cd ml && uvicorn serve.app:app --host 127.0.0.1 --port 8000
# ──────────────
MODEL_SERVICE_URL=http://127.0.0.1:8000
MODEL_TIMEOUT_MS=15000

# ──────────────
# Temporary fallback, used ONLY while the own model is being trained.
# Fires when the model service is unreachable — never to mask a low-confidence
# answer from our own model. Every response carries an `engine` field.
# Leave blank to disable. Remove once the classifier hits its accuracy target.
#   Free-tier key: https://aistudio.google.com/apikey
# ──────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ──────────────
# Cloudinary
# ──────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────
# Client / Socket URLs
# ──────────────
CLIENT_URL=http://localhost:3000

# ──────────────
# Transaction Verification (QR)
# ──────────────
QR_SECRET_KEY=your_qr_secret_key
TRANSACTION_EXPIRY_MINUTES=30

# ──────────────
# Email (Optional — pickup reminders)
# ──────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
