# Photographs and trained weights are large and do not belong in git.
# data/metadata.csv is deliberately NOT ignored: it is small, it is the part of the
# dataset that cannot be recreated by re-shooting, and it is what the thesis describes.
data/raw/
data/manifest.csv
data/splits/
artifacts/*.pt
artifacts/*.onnx
artifacts/*.tflite

# Export bundles are regenerated from a checkpoint by scripts/export.py. The
# patterns above match only direct children of artifacts/, so the graph inside a
# bundle needs its own rule.
artifacts/*_bundle/
__pycache__/
*.pyc

# Working copies of downloaded public datasets
openimages_crops/
taco_crops/
data/yolo_cls/
artifacts/yolo/
*.log
validation-bbox.csv

# Pretrained weights downloaded on demand
yolov8n-cls.pt
yolo*.pt

# Detection dataset and runs (regenerable from taco-annotations.json)
data/detection/
artifacts/detector/
artifacts/*.pt
taco-annotations.json
runs/

oi_paper/
oi-classes.csv
data/quarantine/

# Public datasets as they arrive from their hosts — 2.5 GB and growing, and all
# of it is re-fetchable by scripts/fetch_datasets.py. What has to survive is the
# provenance, and that is in data/public_metadata.jsonl, which is not ignored.
data/downloads/

# Colab upload bundle — 125 MB, regenerated by scripts/make_colab_bundle.py
colab_bundle.zip
colab_bundle/

# Regenerated from observations.csv by split_observations.py, deterministic
# under RANDOM_SEED. Tracking it would duplicate 2.4 MB already in the repo.
data/obs_splits/
