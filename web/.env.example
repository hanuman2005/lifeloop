# LifeLoop web — copy to .env and adjust.
# 127.0.0.1 rather than localhost, deliberately. Node resolves localhost to IPv6
# ::1 first; the dev servers listen on IPv4 only, so every connection fails over
# and costs about 215ms against 1ms for the literal address. With one request per
# screen that is invisible, but a page making six of them loses over a second.
#
# Use your machine's LAN IP instead if you are opening the app from a phone.
VITE_API_URL=http://127.0.0.1:5000/api
VITE_SOCKET_URL=http://127.0.0.1:5000
